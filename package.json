{
  "name": "asa-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestionnaire de serveurs dedies ARK: Survival Ascended",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/src/index.js",
    "test": "tsx --test server/src/**/*.test.ts",
    "rcon": "tsx scripts/rcon.mts",
    "rcon:check": "tsx scripts/rcon-check.mts",
    "start:check": "tsx scripts/start-check.mts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^8.2.0",
    "archiver": "^7.0.1",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
